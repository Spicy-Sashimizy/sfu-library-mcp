.pommel/
.pommel

# Python virtual environment
.venv/

# Python bytecode (never commit — caused old secret-bearing .pyc to be committed)
__pycache__/
*.pyc
*.pyo


# ============================================
# CLAUDEBOX SECRET PROTECTION - .gitignore
# ============================================
# This file protects sensitive information from being committed to git.
# Add this to your project's .gitignore file.

# ============================================
# CREDENTIALS & SECRETS
# ============================================

# Environment files
.env
.env.*
!.env.example
!.env.template
*.env
.envrc

# API Keys & Tokens
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*_rsa
*_rsa.pub
*_dsa
*_dsa.pub
*_ecdsa
*_ecdsa.pub
*_ed25519
*_ed25519.pub

# OAuth & Credentials
credentials.json
oauth*.json
client_secret*.json
service_account*.json
*credentials*.json
*secrets*.json
*token*.json
auth.json
config.secret.json
secrets.yaml
secrets.yml

# AWS
.aws/
aws_credentials
*.aws

# Azure
.azure/
azure.json
azure-credentials.json

# GCP/Google Cloud
gcloud/
application_default_credentials.json
*.gcp.json

# Database
*.sqlite
*.db
database.yml
database.json

# ============================================
# SENSITIVE DIRECTORIES
# ============================================

credentials/
secrets/
private/
.secrets/
.private/
.credentials/
certs/

# ============================================
# COMMON SENSITIVE PATTERNS
# ============================================

# Config files that might contain secrets
*config.local.*
*config.prod.*
*config.production.*
settings.local.*
local_settings.*
*.local.json
*.local.yaml
*.local.yml

# Backup files (may contain secrets)
*.bak
*.backup
*.old
*~

# ============================================
# IDE & EDITOR SECRETS
# ============================================

# VS Code
.vscode/settings.json
.vscode/launch.json

# JetBrains
.idea/
*.iml

# ============================================
# CLAUDEBOX SPECIFIC
# ============================================

# Pommel cache (contains file paths)
.pommel

# Local overrides
*.local

!keys/
!.git-crypt/

# Session logs (contain PII like names/emails)
202[0-9]-*.txt

# Stale backup files
*.backup[0-9]*
*.before-fix
*.pre-fix-backup

