{
  "index_patterns": ["openalex_works_dense*"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "30s",
      "index.knn": true
    },
    "mappings": {
      "properties": {
        "doi": { "type": "keyword" },
        "openalex_id": { "type": "keyword" },
        "title": { "type": "text" },
        "abstract": { "type": "text" },
        "publication_year": { "type": "integer" },
        "type": { "type": "keyword" },
        "is_oa": { "type": "boolean" },
        "embedding": {
          "type": "knn_vector",
          "dimension": 384,
          "method": {
            "name": "hnsw",
            "engine": "lucene",
            "space_type": "cosinesimil",
            "parameters": {
              "m": 16,
              "ef_construction": 256
            }
          }
        }
      }
    }
  }
}
