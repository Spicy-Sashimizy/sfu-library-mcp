{
  "mcpServers": {
    "sfu-library-training": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "claudebox-sfu-library-mcp-training-app",
        "mcp-remote",
        "http://127.0.0.1:8080/mcp",
        "--allow-http",
        "--transport",
        "http-only"
      ]
    }
  }
}
