{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse HEAD > \"${CLAUDE_PROJECT_DIR:-.}/.claude/.session_start_head\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doc_sync_check.sh\"",
            "timeout": 15,
            "statusMessage": "Doc-sync check (src/scripts commits vs docs)"
          }
        ]
      }
    ]
  }
}
